# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_TYPE=supabase

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_BOOKS=books
SUPABASE_STORAGE_BUCKET_PROFILE=profile
SUPABASE_STORAGE_BUCKET_IMAGE=image

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Security Configuration
SESSION_SECRET=your-strong-random-session-secret-here
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD_HASH=your-bcrypt-hashed-password

# Optional Configuration
SESSION_MAX_AGE=86400000
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpeg|jpg|png|gif|webp
