<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Köp <%= book.title %> - Mikael Dolfe</title>
    <meta name="description" content="Köp <%= book.title %> av Mikael Dolfe">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="stylesheet" href="/assets/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Source+Sans+Pro:wght@300;400;600&display=swap" rel="stylesheet">
    <script src="https://js.stripe.com/v3/"></script>
    <style>
        .purchase-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            margin-top: 8rem; /* Add space for fixed header */
        }
        
        .purchase-header {
            text-align: center;
            margin-bottom: 3rem;
        }
        
        .back-link {
            display: inline-block;
            margin-bottom: 2rem;
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
            font-size: 1.1rem;
        }
        
        .back-link:hover {
            text-decoration: underline;
        }
        
        .purchase-title {
            font-size: 2.5rem;
            color: #2c3e50;
            margin-bottom: 1rem;
            font-family: 'Playfair Display', serif;
        }
        
        .book-info {
            background: #f8f9fa;
            padding: 2rem;
            border-radius: 15px;
            margin-bottom: 2rem;
            display: flex;
            gap: 2rem;
            align-items: center;
        }
        
        .book-cover {
            width: 150px;
            height: 225px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .book-cover-placeholder {
            width: 150px;
            height: 225px;
            background: linear-gradient(135deg, #e9ecef, #dee2e6);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 0.9rem;
            text-align: center;
        }
        
        .book-details h3 {
            font-size: 1.5rem;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }
        .book-details p {
            text-align: center;
        }
        
        .book-price {
            font-size: 1.8rem;
            color: #e74c3c;
            font-weight: 700;
            font-family: 'Playfair Display', serif;
            text-align: center;
        }
        
        .purchase-form {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }
        
        .form-section {
            margin-bottom: 2rem;
        }
        
        .form-section h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            font-size: 1.3rem;
            border-bottom: 2px solid #3498db;
            padding-bottom: 0.5rem;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        
        .form-group {
            margin-bottom: 1rem;
        }
        
        .form-group.full-width {
            grid-column: 1 / -1;
        }
        
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #2c3e50;
        }
        
        .form-input,
        .form-textarea {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }
        
        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }
        
        .form-textarea {
            min-height: 80px;
            resize: vertical;
        }
        
        .required {
            color: #e74c3c;
        }
        
        .checkbox-group {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .checkbox-group input[type="checkbox"] {
            margin-top: 0.2rem;
        }
        
        .checkbox-group label {
            font-size: 0.9rem;
            line-height: 1.4;
        }
        
        .payment-section {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 10px;
            margin-top: 2rem;
        }
        
        .payment-element {
            margin-bottom: 1rem;
        }
        
        .btn {
            display: inline-block;
            padding: 1rem 2rem;
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
        }
        
        .btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
            opacity: 0.5;
        }
        
        #continue-button:disabled {
            background: #95a5a6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
            opacity: 0.5;
        }
        
        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            margin-top: 1rem;
        }
        
        /* Locked form state */
        .form-section.locked {
            opacity: 0.6;
            pointer-events: none;
            position: relative;
        }
        
        .form-section.locked::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            pointer-events: none;
        }
        
        .form-input:disabled {
            background-color: #f8f9fa;
            color: #6c757d;
            cursor: not-allowed;
        }
        
        .error-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }
        
        .loading {
            display: none;
            text-align: center;
            margin: 1rem 0;
        }
        
        .spinner {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        @media (max-width: 768px) {
            .purchase-container {
                padding: 1rem;
                margin-top: 12rem; /* Extra space for mobile header */
            }
            
            .purchase-title {
                font-size: 2rem;
            }
            
            .book-info {
                flex-direction: column;
                text-align: center;
                gap: 1rem;
                padding: 1.5rem;
            }
            
            .book-cover,
            .book-cover-placeholder {
                width: 120px;
                height: 180px;
            }
            
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .purchase-form {
                padding: 1.5rem;
            }
            
            .form-section h3 {
                font-size: 1.2rem;
            }
            
            .payment-section {
                padding: 1rem;
            }
            
            .btn {
                padding: 0.875rem 1.5rem;
                font-size: 1rem;
            }
        }
        
        @media (max-width: 480px) {
            .purchase-container {
                padding: 0.5rem;
            }
            
            .purchase-title {
                font-size: 1.8rem;
            }
            
            .book-info {
                padding: 1rem;
            }
            
            .book-cover,
            .book-cover-placeholder {
                width: 100px;
                height: 150px;
            }
            
            .purchase-form {
                padding: 1rem;
            }
            
            .form-input,
            .form-textarea {
                padding: 0.625rem;
                font-size: 0.9rem;
            }
            
            .form-label {
                font-size: 0.9rem;
            }
            
            .payment-section {
                padding: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <%- include('components/header') %>

    <main>
        <div class="purchase-container">
            <a href="/book/<%= book.id %>" class="back-link">← Tillbaka till boken</a>
            
            <div class="purchase-header">
                <h1 class="purchase-title">Köp bok</h1>
            </div>
            
            <div class="book-info">
                <% if (book.cover_image) { %>
                    <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="book-cover">
                <% } else { %>
                    <div class="book-cover-placeholder">
                        Omslagsbild saknas
                    </div>
                <% } %>
                
                <div class="book-details">
                    <h3><%= book.title %></h3>
                    <% if (book.subtitle) { %>
                        <p style="color: #7f8c8d; font-style: italic; margin-bottom: 1rem;"><%= book.subtitle %></p>
                    <% } %>
                    <div class="book-price"><%= book.price %> SEK</div>
                </div>
            </div>
            
            <form id="purchase-form" class="purchase-form">
                <div class="form-section" id="contact-section">
                    <h3>Kontaktinformation</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name" class="form-label">Fullständigt namn <span class="required">*</span></label>
                            <input type="text" id="name" name="name" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="email" class="form-label">E-postadress <span class="required">*</span></label>
                            <input type="email" id="email" name="email" class="form-input" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="phone" class="form-label">Telefonnummer <span class="required">*</span></label>
                        <input type="tel" id="phone" name="phone" class="form-input" required>
                    </div>
                </div>
                
                <div class="form-section" id="address-section">
                    <h3>Leveransadress</h3>
                    <div class="form-group">
                        <label for="address" class="form-label">Adress <span class="required">*</span></label>
                        <input type="text" id="address" name="address" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label for="address2" class="form-label">Adressrad 2 (valfritt)</label>
                        <input type="text" id="address2" name="address2" class="form-input">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="postalCode" class="form-label">Postnummer <span class="required">*</span></label>
                            <input type="text" id="postalCode" name="postalCode" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="city" class="form-label">Stad <span class="required">*</span></label>
                            <input type="text" id="city" name="city" class="form-input" required>
                        </div>
                    </div>
                    
                    <button type="button" id="continue-button" class="btn btn-secondary" style="margin-top: 1rem;">
                        Fortsätt till betalning
                    </button>
                </div>
                
                <!-- Edit button (initially hidden) -->
                <div id="edit-section" style="display: none; text-align: center; margin: 2rem 0;">
                    <button type="button" id="edit-button" class="btn btn-secondary" style="display: inline-block; padding: 0.5rem 1rem; font-size: 0.9rem;">
                        Ändra
                    </button>
                </div>
                
                <div class="form-section">
                    <div class="checkbox-group">
                        <input type="checkbox" id="terms" name="terms" required>
                        <label for="terms">Jag godkänner <a href="#" target="_blank">köpvillkoren</a> och <a href="#" target="_blank">integritetspolicyn</a> <span class="required">*</span></label>
                    </div>
                </div>
                
                <% if (stripeConfigured) { %>
                    <div class="payment-section">
                        <h3>Betalning</h3>
                        <div class="payment-element" id="payment-element">
                            <!-- Stripe Elements will be inserted here -->
                        </div>
                        <div id="payment-message" class="error-message" style="display: none;"></div>
                    </div>
                <% } else { %>
                    <div class="payment-section" style="background: #fff3cd; border: 1px solid #ffeaa7; padding: 1.5rem; border-radius: 10px;">
                        <h3 style="color: #856404;">Betalning</h3>
                        <p style="color: #856404; margin-bottom: 1rem;">
                            Stripe är inte konfigurerat än. För att aktivera betalningar, lägg till dina Stripe API-nycklar i .env-filen.
                        </p>
                        <div style="background: #f8f9fa; padding: 1rem; border-radius: 5px; font-family: monospace; font-size: 0.9rem;">
                            STRIPE_SECRET_KEY=sk_test_your_key_here<br>
                            STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
                        </div>
                    </div>
                <% } %>
                
                <div class="loading" id="loading">
                    <div class="spinner"></div>
                    <p>Bearbetar betalning...</p>
                </div>
                
                <button type="submit" id="submit-button" class="btn" <%= !stripeConfigured ? 'disabled' : '' %>>
                    <% if (stripeConfigured) { %>
                        Betala köp
                    <% } else { %>
                        Stripe inte konfigurerat
                    <% } %>
                </button>
            </form>
        </div>
    </main>

    <%- include('components/footer') %>

    <script src="/assets/scripts/script.js"></script>
    <script>
        // Initialize Stripe
        const stripe = Stripe('<%= stripePublishableKey %>');
        let elements;
        let paymentElement;
        let paymentInitialized = false;
        let storedCustomerInfo = null;
        
        // Form elements
        const form = document.getElementById('purchase-form');
        const submitButton = document.getElementById('submit-button');
        const continueButton = document.getElementById('continue-button');
        const editButton = document.getElementById('edit-button');
        const loading = document.getElementById('loading');
        const paymentMessage = document.getElementById('payment-message');
        const paymentSection = document.querySelector('.payment-section');
        const contactSection = document.getElementById('contact-section');
        const addressSection = document.getElementById('address-section');
        const editSection = document.getElementById('edit-section');
        
        // Initialize payment form
        async function initializePayment() {
            if (paymentInitialized) {
                return;
            }
            
            try {
                console.log('🔄 Initializing payment...');
                
                // Use stored customer info instead of form data
                if (!storedCustomerInfo) {
                    console.error('❌ No stored customer info available');
                    showMessage('Kunde inte hämta kundinformation. Vänligen försök igen.', 'error');
                    return;
                }
                
                console.log('📝 Using stored customer info:', storedCustomerInfo);
                
                // Create payment intent
                const response = await fetch('/create-payment-intent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        bookId: '<%= book.id %>',
                        customerInfo: storedCustomerInfo
                    })
                });
                
                const result = await response.json();
                console.log('💳 Payment intent response:', result);
                
                if (result.error) {
                    showMessage(result.error, 'error');
                    return;
                }
                
                // Initialize Stripe Elements
                elements = stripe.elements({ clientSecret: result.clientSecret });
                paymentElement = elements.create('payment');
                paymentElement.mount('#payment-element');
                
                paymentInitialized = true;
                console.log('✅ Payment initialized successfully');
                
            } catch (error) {
                console.error('❌ Error initializing payment:', error);
                showMessage('Ett fel uppstod vid initialisering av betalningen.', 'error');
            }
        }
        
        // Handle form submission
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            console.log('🚀 Form submitted');
            
            if (!paymentElement) {
                showMessage('Betalningsformuläret är inte redo än. Klicka på "Fortsätt till betalning" först.', 'error');
                return;
            }
            
            setLoading(true);
            
            try {
                const { error } = await stripe.confirmPayment({
                    elements,
                    confirmParams: {
                        return_url: `${window.location.origin}/payment/success`,
                    },
                });
                
                if (error) {
                    console.error('❌ Payment error:', error);
                    showMessage(error.message, 'error');
                }
            } catch (error) {
                console.error('❌ Error confirming payment:', error);
                showMessage('Ett fel uppstod vid betalningen.', 'error');
            } finally {
                setLoading(false);
            }
        });
        
        // Handle continue button click
        continueButton.addEventListener('click', async (event) => {
            event.preventDefault();
            console.log('🔄 Continue button clicked');
            
            // Validate required fields
            const requiredFields = ['name', 'email', 'phone', 'address', 'postalCode', 'city'];
            const missingFields = [];
            
            requiredFields.forEach(fieldName => {
                const field = document.getElementById(fieldName);
                if (!field.value.trim()) {
                    missingFields.push(fieldName);
                }
            });
            
            if (missingFields.length > 0) {
                showMessage(`Vänligen fyll i alla obligatoriska fält: ${missingFields.join(', ')}`, 'error');
                return;
            }
            
            // Validate email format
            const emailField = document.getElementById('email');
            if (!isValidEmail(emailField.value.trim())) {
                showMessage('Vänligen ange en giltig e-postadress', 'error');
                return;
            }
            
            // Store customer info before locking form
            storedCustomerInfo = {
                name: document.getElementById('name').value.trim(),
                email: document.getElementById('email').value.trim(),
                phone: document.getElementById('phone').value.trim(),
                deliveryAddress: {
                    address: document.getElementById('address').value.trim(),
                    address2: document.getElementById('address2').value.trim(),
                    postalCode: document.getElementById('postalCode').value.trim(),
                    city: document.getElementById('city').value.trim()
                }
            };
            
            console.log('💾 Stored customer info:', storedCustomerInfo);
            
            // Lock form sections
            lockFormSections();
            
            // Show payment section
            paymentSection.style.display = 'block';
            continueButton.style.display = 'none';
            
            // Show edit button
            editSection.style.display = 'block';
            
            // Show and enable submit button
            submitButton.style.display = 'block';
            submitButton.disabled = false;
            
            // Initialize payment
            await initializePayment();
        });
        
        // Show/hide loading state
        function setLoading(isLoading) {
            submitButton.disabled = isLoading;
            loading.style.display = isLoading ? 'block' : 'none';
        }
        
        // Show error/success messages
        function showMessage(message, type) {
            paymentMessage.textContent = message;
            paymentMessage.style.display = 'block';
            paymentMessage.style.color = type === 'error' ? '#e74c3c' : '#27ae60';
        }
        
        // Email validation function
        function isValidEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }
        
        // Check if form is valid for continue button
        function checkFormValidity() {
            const requiredFields = ['name', 'email', 'phone', 'address', 'postalCode', 'city'];
            const fieldValues = {};
            const allFieldsFilled = requiredFields.every(fieldName => {
                const field = document.getElementById(fieldName);
                fieldValues[fieldName] = field ? field.value.trim() : '';
                return field && field.value.trim() !== '';
            });
            
            // Check email validity
            const emailField = document.getElementById('email');
            const emailValid = emailField && isValidEmail(emailField.value.trim());
            
            console.log('🔍 Form validation check:', { fieldValues, allFieldsFilled, emailValid });
            
            const formValid = allFieldsFilled && emailValid;
            continueButton.disabled = !formValid;
            
            if (formValid) {
                continueButton.style.opacity = '1';
                continueButton.style.cursor = 'pointer';
                continueButton.style.background = 'linear-gradient(135deg, #3498db, #2980b9)';
                console.log('✅ Continue button enabled');
            } else {
                continueButton.style.opacity = '0.5';
                continueButton.style.cursor = 'not-allowed';
                continueButton.style.background = 'linear-gradient(135deg, #95a5a6, #7f8c8d)';
                console.log('❌ Continue button disabled');
            }
            
            // Show email validation error
            if (emailField && emailField.value.trim() !== '' && !emailValid) {
                showFieldError('email', 'Vänligen ange en giltig e-postadress');
            } else {
                clearFieldError('email');
            }
        }
        
        // Show field-specific error
        function showFieldError(fieldName, message) {
            const field = document.getElementById(fieldName);
            if (field) {
                field.style.borderColor = '#e74c3c';
                let errorDiv = field.parentNode.querySelector('.field-error');
                if (!errorDiv) {
                    errorDiv = document.createElement('div');
                    errorDiv.className = 'field-error';
                    errorDiv.style.color = '#e74c3c';
                    errorDiv.style.fontSize = '0.9rem';
                    errorDiv.style.marginTop = '0.25rem';
                    field.parentNode.appendChild(errorDiv);
                }
                errorDiv.textContent = message;
            }
        }
        
        // Clear field-specific error
        function clearFieldError(fieldName) {
            const field = document.getElementById(fieldName);
            if (field) {
                field.style.borderColor = '#e9ecef';
                const errorDiv = field.parentNode.querySelector('.field-error');
                if (errorDiv) {
                    errorDiv.remove();
                }
            }
        }
        
        // Lock form sections
        function lockFormSections() {
            console.log('🔒 Locking form sections');
            
            // Add locked class to sections
            contactSection.classList.add('locked');
            addressSection.classList.add('locked');
            
            // Disable all form inputs in locked sections
            const inputs = contactSection.querySelectorAll('input');
            inputs.forEach(input => {
                input.disabled = true;
            });
            
            const addressInputs = addressSection.querySelectorAll('input');
            addressInputs.forEach(input => {
                input.disabled = true;
            });
        }
        
        // Unlock form sections
        function unlockFormSections() {
            console.log('🔓 Unlocking form sections');
            
            // Remove locked class from sections
            contactSection.classList.remove('locked');
            addressSection.classList.remove('locked');
            
            // Enable all form inputs in sections
            const inputs = contactSection.querySelectorAll('input');
            inputs.forEach(input => {
                input.disabled = false;
            });
            
            const addressInputs = addressSection.querySelectorAll('input');
            addressInputs.forEach(input => {
                input.disabled = false;
            });
        }
        
        // Reset form to initial state
        function resetFormState() {
            console.log('🔄 Resetting form state');
            
            // Clear stored customer info
            storedCustomerInfo = null;
            
            // Unlock form sections
            unlockFormSections();
            
            // Hide payment section
            paymentSection.style.display = 'none';
            
            // Hide edit section
            editSection.style.display = 'none';
            
            // Show continue button
            continueButton.style.display = 'block';
            continueButton.disabled = true;
            continueButton.style.opacity = '0.5';
            continueButton.style.cursor = 'not-allowed';
            continueButton.style.background = 'linear-gradient(135deg, #95a5a6, #7f8c8d)';
            
            // Hide submit button
            submitButton.style.display = 'none';
            
            // Reset payment state
            paymentInitialized = false;
            if (paymentElement) {
                paymentElement.unmount();
                paymentElement = null;
            }
            if (elements) {
                elements = null;
            }
            
            // Clear any error messages
            paymentMessage.style.display = 'none';
            
            // Re-run form validation
            checkFormValidity();
        }
        
        // Add event listeners to form fields for real-time validation
        function setupFormValidation() {
            const formFields = ['name', 'email', 'phone', 'address', 'postalCode', 'city'];
            
            formFields.forEach(fieldName => {
                const field = document.getElementById(fieldName);
                if (field) {
                    field.addEventListener('input', checkFormValidity);
                    field.addEventListener('blur', checkFormValidity);
                }
            });
        }
        
        // Handle edit button click
        editButton.addEventListener('click', (event) => {
            event.preventDefault();
            console.log('✏️ Edit button clicked');
            resetFormState();
        });
        
        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', () => {
            console.log('📄 Page loaded');
            
            // Hide payment section initially
            if (paymentSection) {
                paymentSection.style.display = 'none';
            }
            
            // Hide submit button initially
            submitButton.style.display = 'none';
            
            // Hide edit section initially
            editSection.style.display = 'none';
            
            // Disable continue button initially
            continueButton.disabled = true;
            continueButton.style.opacity = '0.5';
            continueButton.style.cursor = 'not-allowed';
            
            // Setup form validation
            setupFormValidation();
            
            // Initial form check
            checkFormValidity();
        });
    </script>
</body>
</html>