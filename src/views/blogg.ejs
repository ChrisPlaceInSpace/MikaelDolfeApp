<!DOCTYPE html>
<html lang="sv">
<head>
<%- include('components/head-base', {
  pageTitle: 'Blogg - Mikael Dolfe',
  pageDescription: 'Följ Mikaels tankar, inspiration och processer som författare och konstnär.',
  canonicalPath: '/blogg',
  ogType: 'website'
}) %>
    <style>
        html, body { height: 100%; }
        body { display: flex; flex-direction: column; }
        main { flex: 1; }

        .blogg-hero {
            background: #f3ede3;
            border-bottom: 1px solid #e8ddd0;
            padding: 5rem 0 3.5rem;
            text-align: center;
        }

        .blogg-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 2.8rem);
            color: #2d1b0e;
            margin-bottom: 1rem;
            position: relative;
            padding-bottom: 1.25rem;
        }

        .blogg-hero h1::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 48px;
            height: 2px;
            background: #8c3a2b;
            border-radius: 2px;
        }

        .blogg-hero p {
            color: #7a6a5a;
            font-size: 1.05rem;
            max-width: 580px;
            margin: 0 auto;
        }

        .blogg-content {
            padding: 4rem 0;
            background: #faf8f4;
        }

        .no-posts {
            text-align: center;
            color: #7a6a5a;
            font-size: 1rem;
            padding: 3rem 0;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 2rem;
            color: #8c3a2b;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .back-link:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <%- include('components/header') %>

    <main>
        <section class="blogg-hero">
            <div class="container">
                <h1>Blogg</h1>
                <p>Följ Mikaels tankar, inspiration och processer som författare och konstnär.</p>
            </div>
        </section>

        <section class="blogg-content">
            <div class="container">
                <a href="/" class="back-link">← Tillbaka till startsidan</a>
                <% if (posts && posts.length > 0) { %>
                    <div class="blog-grid">
                        <% posts.forEach(function(post) { %>
                            <a href="/blog/<%= post.id %>" class="blog-post">
                                <div class="blog-date"><%= new Date(post.created_at).toLocaleDateString('sv-SE') %></div>
                                <h3><%= post.title %></h3>
                                <% if (post.excerpt) { %>
                                    <p><%= post.excerpt %></p>
                                <% } %>
                                <span class="read-more">Läs mer</span>
                            </a>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="no-posts">Inga blogginlägg tillgängliga än.</div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('components/footer') %>

    <script src="/assets/scripts/script.js"></script>
</body>
</html>
