<!DOCTYPE html>
<html lang="sv">
<head>
<% 
  const bookDesc = book.description || book.subtitle || book.title;
  const bookOgImage = book.cover_image ? absoluteUrl(book.cover_image) : absoluteUrl('/assets/favicon.svg');
%>
<%- include('components/head-base', {
  pageTitle: book.title + ' - Mikael Dolfe',
  pageDescription: bookDesc,
  canonicalPath: '/book/' + book.id,
  ogImage: bookOgImage,
  ogType: 'website',
  ogDescription: bookDesc
}) %>
    <style>
        html, body { height: 100%; }
        body { display: flex; flex-direction: column; }
        main { flex: 1; }

        .book-detail {
            padding: 4rem 0;
            background: #faf8f4;
            min-height: calc(100vh - 200px);
        }

        .book-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 1.25rem;
        }

        .book-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .book-title {
            font-size: clamp(2rem, 5vw, 3rem);
            color: #2d1b0e;
            margin-bottom: 1rem;
            font-family: 'Playfair Display', serif;
            line-height: 1.2;
        }

        .book-subtitle {
            font-size: clamp(1.1rem, 2.5vw, 1.8rem);
            color: #7a6a5a;
            font-style: italic;
            margin-bottom: 2.5rem;
            font-family: 'Playfair Display', serif;
        }

        .book-meta {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .meta-item {
            background: white;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            color: #2d1b0e;
            box-shadow: 0 2px 8px rgba(45, 27, 14, 0.08);
            border: 1px solid #e8ddd0;
        }

        .book-content {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 3rem;
            align-items: start;
        }

        .book-cover-section {
            text-align: center;
            display: grid;
            place-items: center;
        }

        .book-cover {
            width: 100%;
            max-width: 300px;
            height: 450px;
            object-fit: cover;
            border-radius: 6px 6px 48px 6px;
            box-shadow: 0 12px 40px rgba(45, 27, 14, 0.22);
            margin-bottom: 1rem;
        }

        .book-cover-placeholder {
            width: 100%;
            max-width: 300px;
            height: 450px;
            background: #f3ede3;
            border-radius: 6px 6px 48px 6px;
            border: 2px solid #e8ddd0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #7a6a5a;
            font-size: 1rem;
            margin: 0 auto 1rem;
        }

        .book-details {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(45, 27, 14, 0.09);
            border: 1px solid #e8ddd0;
        }

        .book-description {
            font-size: 1.05rem;
            line-height: 1.85;
            color: #3d2b1f;
            margin-bottom: 2rem;
        }

        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: #8c3a2b;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            transition: all 0.25s ease;
        }

        .btn:hover {
            background: #6e2d20;
            transform: translateY(-2px);
            box-shadow: 0 5px 18px rgba(140, 58, 43, 0.35);
        }

        .btn-secondary {
            background: #7a6a5a;
        }

        .btn-secondary:hover {
            background: #5e5148;
            box-shadow: 0 5px 15px rgba(94, 81, 72, 0.3);
        }

        .book-price-section {
            margin-top: 2rem;
            padding: 2rem;
            background: #f3ede3;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #e8ddd0;
        }

        .price-display {
            margin-bottom: 1.5rem;
        }

        .price-label {
            font-size: 1.1rem;
            color: #2d1b0e;
            font-weight: 600;
            margin-right: 0.4rem;
        }

        .price-amount {
            font-size: 1.5rem;
            color: #8c3a2b;
            font-weight: 700;
            font-family: 'Playfair Display', serif;
        }

        .btn-purchase {
            background: #8c3a2b;
            color: white;
            padding: 0.875rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            display: inline-block;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(140, 58, 43, 0.3);
        }

        .btn-purchase:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(140, 58, 43, 0.4);
            background: #6e2d20;
            color: white;
        }

        .book-purchase-info {
            font-size: 1rem;
            color: #3d2b1f;
            margin-bottom: 1.2rem;
            font-weight: 500;
        }

        .book-audiobook-link {
            margin-top: 1.2rem;
            font-size: 0.9rem;
            color: #7a6a5a;
        }

        .book-audiobook-link a {
            color: #8c3a2b;
            text-decoration: none;
            font-weight: 600;
        }

        .book-audiobook-link a:hover {
            text-decoration: underline;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 2rem;
            color: #8c3a2b;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .breadcrumb {
            margin-bottom: 2rem;
            font-size: 0.85rem;
            color: #7a6a5a;
        }

        .breadcrumb a {
            color: #8c3a2b;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        /* Book Blurbs */
        .book-blurbs-section {
            margin-top: 4rem;
            padding: 3rem 2rem;
            background: #f3ede3;
            border-radius: 12px;
            border: 1px solid #e8ddd0;
        }

        .blurbs-title {
            text-align: center;
            font-size: clamp(1.6rem, 4vw, 2.2rem);
            color: #2d1b0e;
            margin-bottom: 3rem;
            font-family: 'Playfair Display', serif;
            position: relative;
            padding-bottom: 1.25rem;
        }

        .blurbs-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 48px;
            height: 2px;
            background: #8c3a2b;
            border-radius: 2px;
        }

        .blurbs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            max-width: 960px;
            margin: 0 auto;
        }

        .blurb-card {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(45, 27, 14, 0.09);
            border: 1px solid #e8ddd0;
            border-left: 4px solid #8c3a2b;
            transition: all 0.25s ease;
            position: relative;
        }

        .blurb-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(45, 27, 14, 0.15);
        }

        .blurb-card::before {
            content: '\201C';
            position: absolute;
            top: -8px;
            left: 20px;
            font-size: 4rem;
            color: #8c3a2b;
            font-family: 'Playfair Display', serif;
            opacity: 0.22;
            line-height: 1;
        }

        .blurb-quotation {
            font-size: 1.05rem;
            line-height: 1.75;
            color: #3d2b1f;
            margin-bottom: 1.5rem;
            font-style: italic;
            position: relative;
            z-index: 1;
        }

        .blurb-author {
            font-size: 0.88rem;
            color: #7a6a5a;
            font-weight: 600;
            text-align: right;
            border-top: 1px solid #e8ddd0;
            padding-top: 1rem;
        }

        @media (max-width: 768px) {
            .book-content { grid-template-columns: 1fr; gap: 2rem; }
            .book-detail { padding: 0; padding-bottom: 4rem; }
            .book-container { padding: 0 1rem; margin-top: 3rem; }
            .blurbs-grid { grid-template-columns: 1fr; }
            .blurb-card { padding: 1.5rem; }
            .blurb-card::before { display: none; }
            .book-blurbs-section { margin-top: 2rem; padding: 2rem 1rem; }
            .btn { width: 100%; text-align: center; }
        }

        @media (max-width: 480px) {
            .book-description { font-size: 0.95rem; }
            .blurb-card { padding: 1rem; }
            .blurb-quotation { font-size: 1rem; }
            .book-blurbs-section { padding: 1.5rem 0.5rem; }
        }
    </style>
</head>
<body>
    <%- include('components/header') %>

    <main>
        <section class="book-detail">
            <div class="book-container">
                <a href="/#bocker" class="back-link">← Tillbaka till Böcker</a>
                
                <div class="breadcrumb">
                    <a href="/">Hem</a> > <a href="/#bocker">Böcker</a> > <%= book.title %>
                </div>
                
                <div class="book-header">
                    <h1 class="book-title"><%= book.title %></h1>
                    <% if (book.subtitle) { %>
                        <h2 class="book-subtitle"><%= book.subtitle %></h2>
                    <% } %>
                    
                    <% if (book.release_date) { %>
                        <div class="book-meta">
                            <span class="meta-item">
                                Utgivningsdatum: <%= new Date(book.release_date).toLocaleDateString('sv-SE') %>
                            </span>
                        </div>
                    <% } %>
                </div>
                
                <div class="book-content">
                    <div class="book-cover-section">
                        <% if (book.cover_image) { %>
                            <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="book-cover" width="300" height="450" fetchpriority="high" decoding="async">
                        <% } else { %>
                            <div class="book-cover-placeholder">
                                Omslagsbild saknas
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="book-details">
                        <% if (book.description) { %>
                            <div class="book-description">
                                <%= book.description %>
                            </div>
                        <% } %>
                        
                        <% if (book.price && book.price > 0) { %>
                            <div class="book-price-section">
                                <p class="book-purchase-info">Boken kan köpas för <%= book.price %> kr + frakt (69 kr).</p>
                                <a href="/#kontakt" class="btn btn-purchase">Kontakta Mikael</a>
                                <p class="book-audiobook-link"><a href="https://www.adlibris.com/sv/bok/alska-har-sin-tid-boken-om-nancy-9789181009453" target="_blank" rel="noopener noreferrer">För att köpa boken som ljudbok, klicka här</a></p>
                            </div>
                        <% } else { %>
                            <div style="background: #f3ede3; padding: 1rem; border-radius: 8px; margin-top: 2rem; text-align: center; color: #7a6a5a; border: 1px solid #e8ddd0;">
                                <p>Denna bok är inte tillgänglig för köp.</p>
                            </div>
                        <% } %>

                    </div>
                </div>
                
                <!-- Book Blurbs Section -->
                <% if (blurbs && blurbs.length > 0) { %>
                    <div class="book-blurbs-section">
                        <h2 class="blurbs-title">Vad andra säger</h2>
                        <div class="blurbs-grid">
                            <% blurbs.forEach(function(blurb) { %>
                                <div class="blurb-card">
                                    <div class="blurb-quotation">
                                        "<%= blurb.quotation %>"
                                    </div>
                                    <div class="blurb-author">
                                        — <%= blurb.name %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('components/footer') %>

    <script src="/assets/scripts/script.js"></script>
</body>
</html>



